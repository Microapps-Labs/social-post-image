# Choose your own password and generate the secret with: openssl rand -base64 32
AUTH_PASSWORD=replace-with-your-password
AUTH_SECRET=replace-with-a-random-secret

# MongoDB stores saved projects. Override the source's host-specific default.
MONGODB_URI=mongodb://127.0.0.1:27017/social-post-image
MONGODB_DB=social-post-image

# Optional. Used by Generate from post, which sends submitted text to Groq.
# LLM_API_KEY=your-groq-api-key
